# Copy to .env.local for development. Fill values privately; never commit secrets.
# Required by `pnpm doctor` for the connected app and worker:
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SERVICE_ROLE_KEY=
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=
OPENROUTER_API_KEY=
E2B_API_KEY=
# Legacy Stripe webhook routes currently initialize Stripe during the web build.
STRIPE_SECRET_KEY=

# Local command relay (must match the configured Centrifugo deployment):
CENTRIFUGO_WS_URL=
CENTRIFUGO_TOKEN_SECRET=

# App origin; align these with the port used by your web server.
NEXT_PUBLIC_BASE_URL=http://localhost:3020
NEXT_PUBLIC_APP_URL=http://localhost:3020

# Production controls: configure these before a multi-user release.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
LLM_PROXY_SECRET=
OPS_ALERT_WEBHOOK_URL=

# Optional telemetry:
# Set to false before an isolated canary build to omit marketing scripts.
# Unset preserves public production behavior; changing it requires rebuilding.
# See docs/release/hosted-canary.env.example for the canary-only overlay.
# NEXT_PUBLIC_MARKETING_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
# This is a starting template. Provider-specific media, auth, billing and storage
# integrations need their own credentials; consult their setup docs and `doctor`.
