# Marketing telemetry overlay for the isolated hosted-canary web build.
# Add this value to the canary checkout's private .env.local BEFORE next build.
# Next bakes NEXT_PUBLIC_* values into browser assets; setting it only at
# next start does not disable scripts already present in an earlier build.
NEXT_PUBLIC_MARKETING_ANALYTICS_ENABLED=false

# This is not a complete application environment. Supply only the new canary
# Convex/service-authority/Redis bindings; do not copy the release .env.local.
# Keep NEXT_PUBLIC_POSTHOG_KEY and POSTHOG_PROJECT_TOKEN unset for this canary.
# This flag controls MarketingAnalytics only, not PostHog or server error logs.
# Verify /login in a fresh browser context after rebuilding: no Google Ads or
# Google Tag Manager script/request should originate from MarketingAnalytics.
