{
  "name": "rift",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "predev": "npx tsx scripts/doctor.ts",
    "dev": "concurrently --names next,convex,trigger \"RIFT_LOCAL_TERMINAL=1 RIFT_LOCAL_WORKSPACE_ROOT=$PWD next dev --turbopack -p 3010\" \"npx convex dev\" \"RIFT_TRIGGER_DEV_KEEP_WARM=1 trigger dev\"",
    "dev:web": "concurrently --names next,convex \"RIFT_LOCAL_TERMINAL=1 RIFT_LOCAL_WORKSPACE_ROOT=$PWD next dev --turbopack -p 3010\" \"npx convex dev\"",
    "dev:local": "concurrently \"RIFT_LOCAL_TERMINAL=1 RIFT_LOCAL_WORKSPACE_ROOT=$PWD next dev --turbopack -p 3010\" \"npx convex dev --local\"",
    "dev:next": "RIFT_LOCAL_TERMINAL=1 RIFT_LOCAL_WORKSPACE_ROOT=$PWD next dev --turbopack -p 3010",
    "dev:cursor": "concurrently --kill-others-on-fail --names next,trigger \"RIFT_NEXT_DIST_DIR=.next-cursor-3014 RIFT_UI_SKIN=cursor RIFT_LOCAL_TERMINAL=1 RIFT_LOCAL_WORKSPACE_ROOT=$PWD NEXT_PUBLIC_BASE_URL=http://localhost:3014 NEXT_PUBLIC_APP_URL=http://localhost:3014 next dev --turbopack -H localhost -p 3014\" \"RIFT_TRIGGER_DEV_KEEP_WARM=1 trigger dev\"",
    "dev:workbench-preview": "RIFT_NEXT_DIST_DIR=.next-preview-3011 RIFT_UI_SKIN=hack-terminal RIFT_LOCAL_TERMINAL=1 RIFT_LOCAL_WORKSPACE_ROOT=$PWD NEXT_PUBLIC_BASE_URL=http://localhost:3011 NEXT_PUBLIC_APP_URL=http://localhost:3011 next dev --turbopack -H localhost -p 3011",
    "dev:convex": "npx convex dev",
    "dev:trigger": "RIFT_TRIGGER_DEV_KEEP_WARM=1 trigger dev",
    "dev:all": "concurrently \"RIFT_LOCAL_TERMINAL=1 RIFT_LOCAL_WORKSPACE_ROOT=$PWD next dev --turbopack\" \"npx convex dev\" \"RIFT_TRIGGER_DEV_KEEP_WARM=1 trigger dev\"",
    "build": "next build",
    "prepare:monaco": "node scripts/prepare-monaco-assets.cjs",
    "build:ui-release-preview": "node scripts/ui-release-preview.cjs build",
    "start:ui-release-preview": "node scripts/ui-release-preview.cjs start",
    "start": "node scripts/browser-runtime.cjs && next start",
    "prepare:browser": "node scripts/browser-runtime.cjs",
    "lint": "eslint app lib types __mocks__ --ext .ts,.tsx,.js,.jsx",
    "doctor": "npx tsx scripts/doctor.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "pnpm install && node scripts/browser-runtime.cjs && npx tsx scripts/setup.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:report": "playwright show-report",
    "test:e2e:setup": "playwright test --project=setup --workers=1 --reporter=list",
    "user:verify-email": "npx tsx scripts/verify-email.ts",
    "rate-limit:reset": "npx tsx scripts/reset-rate-limit.ts",
    "stripe:attach-failing-card": "npx tsx scripts/attach-failing-card.ts",
    "prepare": "husky",
    "s3:validate": "npx ts-node scripts/validate-s3-security.ts",
    "e2b:build:dev": "npx tsx e2b/build.dev.ts",
    "e2b:build:prod": "npx tsx e2b/build.prod.ts",
    "local-sandbox": "npx tsx packages/local/src/index.ts",
    "local-sandbox:build": "cd packages/local && pnpm build",
    "tauri:dev": "pnpm desktop:dev",
    "tauri:build": "pnpm desktop:build",
    "desktop:dev": "cd packages/desktop && pnpm dev",
    "desktop:build": "cd packages/desktop && pnpm build",
    "docker:build": "docker buildx build --load -t rift/sandbox:latest -f docker/Dockerfile docker/",
    "docker:build:push": "docker buildx build --platform linux/amd64,linux/arm64 --push -t rift/sandbox:latest -f docker/Dockerfile docker/",
    "sandbox:deploy:dev": "pnpm docker:build:push && pnpm e2b:build:dev",
    "sandbox:deploy:prod": "pnpm docker:build:push && pnpm e2b:build:prod",
    "sandbox:deploy": "pnpm docker:build:push && pnpm e2b:build:dev && pnpm e2b:build:prod",
    "lab:open": "echo 'RIFT Pro Lab: http://localhost:3010/lab'",
    "predev:ui-preview": "pnpm run doctor",
    "dev:ui-preview": "concurrently --kill-others --names next,trigger \"pnpm dev:ui-preview:web\" \"pnpm dev:ui-preview:worker\"",
    "dev:ui-preview:web": "RIFT_DISABLE_TURBOPACK_DISK_CACHE=1 RIFT_NEXT_DIST_DIR=.next-reference RIFT_LOCAL_TERMINAL=1 RIFT_LOCAL_WORKSPACE_ROOT=$PWD NEXT_PUBLIC_BASE_URL=http://localhost:3020 NEXT_PUBLIC_APP_URL=http://localhost:3020 next dev --turbopack -H 127.0.0.1 -p 3020",
    "dev:ui-preview:worker": "RIFT_TRIGGER_DEV_KEEP_WARM=1 RIFT_LOCAL_TERMINAL=1 RIFT_LOCAL_WORKSPACE_ROOT=$PWD NEXT_PUBLIC_BASE_URL=http://localhost:3020 NEXT_PUBLIC_APP_URL=http://localhost:3020 trigger dev --env-file .env.local",
    "desktop:ui-preview": "pnpm --dir packages/desktop exec tauri dev --config src-tauri/tauri.ui-preview.conf.json --no-watch",
    "predev:ui-preview:worker": "node -e \"require('node:fs').mkdirSync('.trigger/tmp/store', { recursive: true })\"",
    "local-sandbox:package": "node scripts/package-local-cli.cjs",
    "local-sandbox:verify": "node scripts/package-local-cli.cjs --check && node scripts/smoke-local-cli.cjs",
    "prebuild": "node scripts/package-local-cli.cjs",
    "downloads:verify": "node scripts/package-local-cli.cjs --check && node scripts/verify-desktop-download.cjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.66",
    "@ai-sdk/react": "3.0.193",
    "@auth/core": "^0.37.0",
    "@aws-sdk/client-s3": "3.1055.0",
    "@aws-sdk/s3-request-presigner": "3.1055.0",
    "@convex-dev/aggregate": "^0.2.1",
    "@convex-dev/auth": "^0.0.93",
    "@e2b/code-interpreter": "2.5.0",
    "@langchain/community": "^1.1.29",
    "@lobehub/icons": "^5.16.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@posthog/ai": "7.19.6",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@trigger.dev/build": "4.5.4",
    "@trigger.dev/core": "4.5.4",
    "@trigger.dev/react-hooks": "4.5.4",
    "@trigger.dev/sdk": "4.5.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/functions": "^3.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "6.0.191",
    "ai-elements": "^1.9.0",
    "centrifuge": "^5.6.0",
    "chalk": "^5.6.2",
    "chromium-bidi": "16.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.39.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "4.3.0",
    "e2b": "^2.27.0",
    "franc-min": "^6.2.0",
    "gpt-tokenizer": "^3.4.0",
    "iron-session": "^8.0.4",
    "isbinaryfile": "^6.0.0",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "monaco-editor": "0.55.1",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "openai": "6.39.0",
    "pdfjs-serverless": "^1.2.3",
    "posthog-js": "1.376.3",
    "playwright": "1.55.0",
    "posthog-node": "5.35.5",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hotkeys-hook": "^5.3.2",
    "react-shiki": "^0.10.1",
    "react-textarea-autosize": "^8.5.9",
    "redis": "^5.12.1",
    "resumable-stream": "^2.2.12",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "undici": "^7.25.0",
