{
  "name": "rift-cli",
  "version": "0.8.4",
  "description": "RIFT CLI — run RIFT commands on your local machine from the terminal",
  "bin": {
    "rift-cli": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "node ../../scripts/package-local-cli.cjs --dist-only"
  },
  "keywords": [
    "rift",
    "sandbox",
    "pentesting",
    "security",
    "cli"
  ],
  "author": "RIFT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rift-tech/rift.git",
    "directory": "packages/local"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "centrifuge": "^5.5.3",
    "convex": "^1.39.1",
    "ws": "^8.20.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.2.0-beta.12"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.20.1": "8.20.1"
    }
  }
}
