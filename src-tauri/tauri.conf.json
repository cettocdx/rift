{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RIFT Legacy Development",
  "version": "0.1.0",
  "identifier": "app.riftsys.legacy-development",
  "build": {
    "frontendDist": "./dist",
    "devUrl": "http://localhost:3010",
    "beforeDevCommand": "pnpm dev:next"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/Assets.car": "Assets.car"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
