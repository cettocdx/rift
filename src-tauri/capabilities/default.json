  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "remote": {
    "urls": ["https://riftsys.app/*", "http://localhost:*"]
  },
  "permissions": ["core:default", "core:window:allow-start-dragging"]
}
